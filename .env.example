# Copy to .env on the VM. Caddy must use the same proxy secret.

# Generate a random value and set it in both the app's .env and Caddy's
# ML_SSO_PROXY_SECRET environment.
SSO_PROXY_SECRET=replace-with-shared-random-secret
# Optional mappings preserve existing progress names, e.g. ifkash:enderboi,ananya:michu
SSO_USERS=

# Where progress, drafts, and run history live. A volume in the container.
DATA_DIR=/data

# The local runner's limits. `local_workers` caps how many submissions run at
# once; the other two apply to each one.
LOCAL_WORKERS=2
LOCAL_TIMEOUT_CEILING=180
# Zero leaves the per-process address-space limit off, because numpy and torch
# over-reserve virtual memory. The container's mem_limit bounds resident memory.
LOCAL_MEMORY_MB=0

# RunPod, for the lessons marked `gpu: true`. Leave the endpoint blank and
# those lessons fall back to the local CPU runner.
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=
RUNPOD_GPU=A100-80GB
RUNPOD_TIMEOUT=900
